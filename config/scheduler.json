{
  "pipeline": {
    "event_queue_size": 512,
    "priority_queue_size": 64,
    "market_workers": 5,
    "normalization_workers": 2,
    "strategy_workers": 3,
    "deepseek_workers": 4,
    "shutdown_timeout_seconds": 30,
    "history_preload": {
      "warn_after_seconds": 300
    },
    "cadence_seconds": {
      "full_market": {
        "before_close": 10
      },
      "candidate_quotes": {
        "before_close": 10
      },
      "topk_quotes": {
        "before_close": 10,
        "after_close": 10
      },
      "long_quotes": {
        "before_close": 10,
        "after_close": 10
      },
      "score": {
        "before_close": 10
      },
      "intraday_tail": {
        "afternoon": 10,
        "final_review": 10
      },
      "industry_heat": {
        "warmup": 120,
        "morning": 60,
        "afternoon": 60,
        "final_review": 60
      }
    },
    "publish_heartbeat_seconds": 15
  }
}
